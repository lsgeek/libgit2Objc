# libgit2 构建产物说明:
# 仅提交预编译产物（libgit2.xcframework + git2 头文件），使用者 pod install 开箱即用。
# 中间产物与依赖构建树不入库。重新编译: rm -rf External/libgit2/build && ./Scripts/build_libgit2.sh
External/libgit2/build/*
!External/libgit2/build/lib/
!External/libgit2/build/include/
!External/libgit2/build/include-openssl/

# Demo 构建产物
build-demo/

# iOS Demo
Demo-iOS/Pods/
Demo-iOS/DemoApp.xcworkspace/
Demo-iOS/Podfile.lock
Demo-iOS/DemoApp.xcodeproj/

# 其他
.DS_Store
xcuserdata/
